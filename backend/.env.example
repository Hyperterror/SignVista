# ─── SignVista Backend Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in your values. NEVER commit your real .env.

# ─── Environment ──────────────────────────────────────────────────────────────
# "development" | "production". Anything other than "development" requires SECRET_KEY
# and enables Secure cookies (HTTPS), HSTS, and hides /docs.
ENV=development

# ─── Security ─────────────────────────────────────────────────────────────────
# Required outside development. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# In development, if unset, a random key is generated once into backend/.dev_secret_key
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Override cookie Secure flag (defaults to true outside development)
# COOKIE_SECURE=true
RATE_LIMIT_ENABLED=true
# Debug-only endpoints (/api/debug/*). Never enable in production.
ENABLE_DEBUG_ROUTES=false

# ─── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (also used to validate WebSocket Origin)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Database ─────────────────────────────────────────────────────────────────
# Defaults to backend/signvista.db
# DATABASE_URL=sqlite:////absolute/path/to/signvista.db

# ─── ML ───────────────────────────────────────────────────────────────────────
# Paths may be absolute or relative (ISL_* relative to the repo root, others to backend/)
# ISL_CONFIG_PATH=config/isl_modules.json
# ISL_MODELS_DIR=ISL-Unified-Project/models
# MEDIAPIPE_MODELS_DIR=ml/models
# Optional standalone Keras model used only if the recognition module is unavailable
# MODEL_PATH=ml/models/weights/model.keras
CONFIDENCE_THRESHOLD=0.6
BUFFER_SIZE=45
# Max frames processed per second per stream (extra frames are dropped)
FRAME_PROCESS_FPS=20
MAX_FRAME_SIZE_BYTES=1048576
# Return a fixed "hello" prediction when no model is loaded (tests/demos only)
ALLOW_MOCK_PREDICTIONS=false
# SKIP_ML_WARMUP=false

# ─── Sessions ─────────────────────────────────────────────────────────────────
SESSION_IDLE_TTL_SECONDS=7200

# ─── Game ─────────────────────────────────────────────────────────────────────
GAME_DURATION_SECONDS=30
GAME_POINTS_PER_CORRECT=100
