# SignVista Frontend Environment Variables

# Server-side address of the FastAPI backend. Next.js proxies /api/* and
# /assets/signs/* to it, so the browser only talks to the frontend origin
# for HTTP (the auth cookie stays first-party).
BACKEND_URL=http://127.0.0.1:8000

# WebSockets connect to the backend directly. By default the browser uses
# ws(s)://<current hostname>:<NEXT_PUBLIC_BACKEND_PORT>. Set NEXT_PUBLIC_WS_URL
# when the backend is on a different host (e.g. wss://api.example.com).
NEXT_PUBLIC_BACKEND_PORT=8000
# NEXT_PUBLIC_WS_URL=wss://api.example.com
